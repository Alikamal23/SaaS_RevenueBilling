@inject RevenueBillingApp.Models.Session.Sessions Sessions_
@{
    ViewBag.Title = "Milestones Form";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section TopCss
{
    <link rel="stylesheet" type="text/css" href="~/Public/css/custom-css/Workflow/HistoryCards.css" />

    <link rel="stylesheet" type="text/css" href="~/Public/css/vendors.min.css" />
    <link rel="stylesheet" type="text/css" href="~/Public/css/theme.min.css" />
    <link rel="stylesheet" type="text/css" href="~/Public/css/style.css" />
}

@{

    System.Security.Claims.ClaimsPrincipal claimsPrincipal = Context.User;
    var UniqueKey = (from c in claimsPrincipal.Claims where c.Type == "Guid" select c.Value).FirstOrDefault();
    var UserID = (from c in claimsPrincipal.Claims where c.Type == "UserID" select c.Value).FirstOrDefault();
    RevenueBillingApp.Models.Session.SessionItems sessionItems = Sessions_.GetSession(UniqueKey, UserID);
    List<RevenueBillingApp.Models.Authentication.RolesMapping> rolesMapping = sessionItems.rolesMapping;
    var FilterForm = rolesMapping.FirstOrDefault(x => x.FormName == Context.Request.RouteValues["controller"] + "/" + Context.Request.RouteValues["action"]);
    bool _allowinsert = FilterForm.AllowInsert;
    bool _allowupdate = FilterForm.AllowUpdate;
    bool _allowdelete = FilterForm.AllowDelete;
    string wfCode = ViewBag.wfCode;
    string defaultform = sessionItems.userInfo.DefaultFormName;
}

<div class="page-header mb-2">
    <div class="page-header-left">
        <div class="page-header-title">
            <h4 class="m-b-10">Client Onboarding Overview</h4>
        </div>
        <p class="mb-0">Milestone Form</p>
    </div>
    <div class="page-header-right ms-auto">
        <div class="page-header-right-items">
            <div class="d-flex">
                <a href="/Trans/ViewMilestoneForm" class="btn btn-indigo btn-sm"><i class="feather-list pe-2"></i>Listing</a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card stretch stretch-full">
            <div class="card-header p-0">
            </div>
            <div class="card-body">
                <div id="workflowDiv">
                    <div class="div-loader">
                        <div class="loader-wrapper d-none">
                            <span class="loader"></span>
                        </div>
                        <input type="hidden" id="defaultform" value="@defaultform" />

                        <form id="intiateform" name="intiateform" method="post" action="">
                            <input type="hidden" value="@wfCode" id="workflow" name="workflow" />

                            <input type="hidden" id="hdnMilestoneId" value="@ViewBag.MilestoneId" />
                            <input type="hidden" id="hdnAction" value="Add" />
                            <div class="row" id="appendForm">
                                <div class="nxl-content">
                                    <div class="main-content">
                                        <div class="row mt-2">
                                            <div class="col-12">
                                                <div class="card border-top-0">
                                                    <div class="card-body">
                                                        <h5 class="mb-3 fw-bold">Client Info</h5>
                                                        <div class="row g-3">
                                                            <div class="col-12 col-md-6 col-lg-4">
                                                                <label class="form-label">Client <strong style="color:orangered">*</strong></label>
                                                                <select class="form-select" id="ddlClient" name="ddlClient">
                                                                </select>
                                                            </div>
                                                            <div class="col-12 col-md-6 col-lg-4">
                                                                <label class="form-label">Contract <strong style="color:orangered">*</strong></label>
                                                                <select class="form-select" id="ddlContract" name="ddlContract">
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <hr class="my-0">

                                                    <div class="card-body">
                                                        <h5 class="mb-3 fw-bold">Milestone Details</h5>
                                                        <div class="row g-3">
                                                            <div class="col-12 col-md-6 col-lg-3">
                                                                <label class="form-label">Milestone Name <strong style="color:orangered">*</strong></label>
                                                                <input class="form-control" type="text" id="milestone_name">
                                                            </div>
                                                            <div class="col-12 col-md-6 col-lg-3">
                                                                <label class="form-label">Milestone Amount <strong style="color:orangered">*</strong></label>
                                                                <input class="form-control" type="number" id="milestone_amount">
                                                            </div>
                                                            <div class="col-12 col-md-6 col-lg-3">
                                                                <label class="form-label">Expected Completion Date <strong style="color:orangered">*</strong></label>
                                                                <input class="form-control" type="date" id="exp_completion_date">
                                                            </div>
                                                            <div class="col-12 col-md-6 col-lg-3">
                                                                <label class="form-label">Completion Date</label>
                                                                <input class="form-control" type="date" id="completion_date">
                                                            </div>

                                                            <div class="col-12">
                                                                <label class="form-label">Milestone Description</label>
                                                                <textarea class="form-control" rows="3" id="milestone_desc"></textarea>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <hr class="my-0">

                                                    <div class="card-body">
                                                        <h5 class="mb-3 fw-bold">Team & Approval</h5>
                                                        <div class="row g-3">
                                                            <div class="col-12 col-md-6">
                                                                <label class="form-label">Internal Owner <strong style="color:orangered">*</strong></label>
                                                                <select class="form-select" id="ddlInternalOwner">
                                                                </select>
                                                            </div>
                                                            <div class="col-12 col-md-6">
                                                                <label class="form-label">Client Aprover <strong style="color:orangered">*</strong></label>
                                                                <select class="form-select" id="ddlClientApprover">
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <hr class="my-0">

                                                    <div class="card-body">
                                                        <h5 class="mb-3 fw-bold">Deliverables List</h5>
                                                        <div class="row g-3">
                                                            <div class="multi-field-wrapper">
                                                                <div class="multi-fields">
                                                                    <div class="multi-field d-flex mb-3 gap-2">
                                                                        <div class="w-95">
                                                                            <input type="text" class="form-control deliverables_list" id="deliverables_list">
                                                                        </div>
                                                                        <button type="button" class="btn btn-danger btn-md remove-field w-5"><i class="fa-solid fa-trash"></i></button>
                                                                    </div>
                                                                </div>
                                                                <button type="button" class="btn btn-primary btn-md add-field">Add</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <hr class="my-0">

                                                    <div class="card-body">
                                                        <h5 class="mb-3 fw-bold">Dependencies (Optional)</h5>
                                                        <div class="row g-3">
                                                            <div class="col-12">
                                                                <input type="text" class="form-control" id="dependencies">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <hr class="my-0">

                                                    <div class="card-body" id="docUpload">
                                                        <h5 class="mb-3 fw-bold">Evidence Upload <strong style="color:orangered">*</strong></h5>
                                                        <div class="row g-3">
                                                            <div class="col-12 uploader">
                                                                <label class="upload-box w-100">
                                                                    <input type="file" id="docUpload" name="docUpload" class="d-none file-input" multiple accept=".pdf, .doc, .docx">
                                                                    <h5>Project Scope Document </h5>
                                                                    <p class="text-muted mb-0">PDF, DOCX, DOC</p>
                                                                </label>
                                                                <div class="preview-container row"></div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <hr class="my-0">

                                                    <div class="card-body">
                                                        <div class="row g-3">
                                                            <div class="col-12 col-md-6">
                                                                <label class="form-label w-100">Client Approval <strong style="color:orangered">*</strong></label>
                                                                <div class="form-check form-check-inline">
                                                                    <input class="form-check-input" type="radio" name="question" id="rdoYes" value="Yes">
                                                                    <label class="form-check-label" for="rdoYes">Yes</label>
                                                                </div>
                                                                <div class="form-check form-check-inline">
                                                                    <input class="form-check-input" type="radio" name="question" id="rdoNo" value="No">
                                                                    <label class="form-check-label" for="rdoNo">No</label>
                                                                </div>
                                                            </div>

                                                            <div class="col-12">
                                                                <label class="form-label">Client Comments</label>
                                                                <textarea class="form-control" rows="3" id="client_comments"></textarea>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <hr class="my-0">

                                                    <div class="card-body">
                                                        <h5 class="mb-3 fw-bold">Quality Assurance</h5>
                                                        <div class="row g-3">
                                                            <div class="col-12">
                                                                <label class="form-label">Internal QA Comments</label>
                                                                <input type="text" class="form-control" id="qa_comments">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <hr class="my-0">

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            @if (_allowinsert)
                            {
                                <br />
                                <div class="row ">
                                    @* <div class="d-flex justify-content-end flex-wrap" id="actionId"></div> *@
                                    <div class="d-flex justify-content-end flex-wrap" id="actionId">
                                        <button type="button" class="btn btn-success btn-sm SaveBtn" id="SaveBtn"><i class="feather-save pe-2"></i>Save</button>

                                    </div>
                                </div>
                            }
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section BottomJS {
    <script src="~/Public/js/vendors.min.js"></script>
    <script src="~/Public/js/common-init.min.js"></script>
    @* <script src="~/Public/js/client-onboarding.js"></script> *@

    <script src="~/Public/vendor/leaderline/leaderline.js"></script>
    <script src="~/Public/js/custom-js/Workflow/WorkflowManager.js"></script>
    <script src="~/Public/js/custom-js/Trans/MilestoneForm.js"></script>
}