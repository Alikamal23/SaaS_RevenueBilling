                                                                            <label class="btn rounded" for="riskLow">Low</label>

                                                                            <input type="radio" class="btn-check" name="rdoRisk" id="riskMedium" autocomplete="off" checked value="Medium">
                                                                            <label class="btn rounded" for="riskMedium">Medium</label>

                                                                            <input type="radio" class="btn-check" name="rdoRisk" id="riskHigh" autocomplete="off" value="High">
                                                                            <label class="btn rounded" for="riskHigh">High</label>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-12 col-md-6 col-lg-4">
                                                                        <label class="form-label w-100">Escalation Level <strong style="color:orangered">*</strong></label>
                                                                        <div class="btn-group bg-light px-3 py-1 gap-2" role="group">
                                                                            <input type="radio" class="btn-check" name="rdoEscalation" id="rdoSales" autocomplete="off" value="Sales">
                                                                            <label class="btn rounded" for="rdoSales">Sales</label>

                                                                            <input type="radio" class="btn-check" name="rdoEscalation" id="rdoFinance" autocomplete="off" checked value="Finance">
                                                                            <label class="btn rounded" for="rdoFinance">Finance</label>

                                                                            <input type="radio" class="btn-check" name="rdoEscalation" id="rdoCEO" autocomplete="off" value="CEO">
                                                                            <label class="btn rounded" for="rdoCEO">CEO</label>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-12">
                                                                        <label class="form-label">Notes</label>
                                                                        <textarea class="form-control" rows="3" id="notes"></textarea>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <hr class="my-0">

                                                        </div>
                                                        <div class="tab-pane fade" id="renewalTab" role="tabpanel">
                                                            <div class="card-body">
                                                                <h5 class="mb-3 fw-bold">Renewal Details</h5>
                                                                <div class="row g-3">
                                                                    <div class="col-12 col-md-6 col-lg-3">
                                                                        <label class="form-label">Client <strong style="color:orangered">*</strong></label>
                                                                        <select class="form-select" id="ddlClient" name="ddlClient">
                                                                        </select>
                                                                    </div>
                                                                    <div class="col-12 col-md-6 col-lg-3">
                                                                        <label class="form-label">Contract <strong style="color:orangered">*</strong></label>
                                                                        <select class="form-select" id="ddlContract" name="ddlContract">
                                                                        </select>
                                                                    </div>
                                                                    <div class="col-12 col-md-6 col-lg-3">
                                                                        <label class="form-label">Renewal Term</label>
                                                                        <input class="form-control" type="text" id="renewal_term">
                                                                    </div>
                                                                    <div class="col-12 col-md-6 col-lg-3">
                                                                        <label class="form-label">New Contract Value</label>
                                                                        <input class="form-control" type="number" id="contract_value">
                                                                    </div>
                                                                    <div class="col-12 col-md-6 col-lg-3">
                                                                        <label class="form-label">Discount %</label>
                                                                        <input class="form-control" type="number" id="discount">
                                                                    </div>
                                                                    <div class="col-12 col-md-6 col-lg-3">
                                                                        <label class="form-label">Start Date</label>
                                                                        <input class="form-control" type="date" id="start_date">
                                                                    </div>
                                                                    <div class="col-12 col-md-6 col-lg-3">
                                                                        <label class="form-label">End Date</label>
                                                                        <input class="form-control" type="date" id="end_date">
                                                                    </div>

                                                                    <div id="docSection" class="col-12 uploader">
                                                                        <label class="form-label">Renewal Document Upload</label>
                                                                        <label class="upload-box w-100">
                                                                            <input type="file" name="doc_upload" id="doc_upload" class="d-none file-input" multiple accept=".pdf, .doc, .docx">
                                                                            <h5>Click to Upload</h5>
                                                                            <p class="text-muted mb-0">PDF, DOC, DOCX</p>
                                                                        </label>
                                                                        <div class="preview-container row"></div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <hr class="my-0">

                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            @if (_allowinsert)
                            {
                                <br />
                                <div class="row ">
                                    @* <div class="d-flex justify-content-end flex-wrap" id="actionId"></div> *@
                                    <div class="d-flex justify-content-end flex-wrap" id="actionId">
                                        <button type="button" class="btn btn-success btn-sm SaveBtn" id="SaveBtn"><i class="feather-save pe-2"></i>Save</button>

                                    </div>
                                </div>
                            }
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

