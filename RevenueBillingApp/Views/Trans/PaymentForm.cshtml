@inject RevenueBillingApp.Models.Session.Sessions Sessions_
@{
    ViewBag.Title = "Payment Form";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section TopCss
{
    <link rel="stylesheet" type="text/css" href="~/Public/css/custom-css/Workflow/HistoryCards.css" />

    <link rel="stylesheet" type="text/css" href="~/Public/css/vendors.min.css" />
    <link rel="stylesheet" type="text/css" href="~/Public/css/theme.min.css" />
    <link rel="stylesheet" type="text/css" href="~/Public/css/style.css" />
}

@{

    System.Security.Claims.ClaimsPrincipal claimsPrincipal = Context.User;
    var UniqueKey = (from c in claimsPrincipal.Claims where c.Type == "Guid" select c.Value).FirstOrDefault();
    var UserID = (from c in claimsPrincipal.Claims where c.Type == "UserID" select c.Value).FirstOrDefault();
    RevenueBillingApp.Models.Session.SessionItems sessionItems = Sessions_.GetSession(UniqueKey, UserID);
    List<RevenueBillingApp.Models.Authentication.RolesMapping> rolesMapping = sessionItems.rolesMapping;
    var FilterForm = rolesMapping.FirstOrDefault(x => x.FormName == Context.Request.RouteValues["controller"] + "/" + Context.Request.RouteValues["action"]);
    bool _allowinsert = FilterForm.AllowInsert;
    bool _allowupdate = FilterForm.AllowUpdate;
    bool _allowdelete = FilterForm.AllowDelete;
    string wfCode = ViewBag.wfCode;
    string defaultform = sessionItems.userInfo.DefaultFormName;
}

<div class="page-header mb-2">
    <div class="page-header-left">
        <div class="page-header-title">
            <h4 class="m-b-10">Client Onboarding Overview</h4>
        </div>
        <p class="mb-0">Payment Form</p>
    </div>
    <div class="page-header-right ms-auto">
        <div class="page-header-right-items">
            <div class="d-flex">
                <a href="/Trans/ViewPaymentForm" class="btn btn-indigo btn-sm"><i class="feather-list pe-2"></i>Listing</a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card stretch stretch-full">
            <div class="card-header p-0">
            </div>
            <div class="card-body">
                <div id="workflowDiv">
                    <div class="div-loader">
                        <div class="loader-wrapper d-none">
                            <span class="loader"></span>
                        </div>
                        <input type="hidden" id="defaultform" value="@defaultform" />

                        <form id="intiateform" name="intiateform" method="post" action="">
                            <input type="hidden" value="@wfCode" id="workflow" name="workflow" />

                            <input type="hidden" id="hdnPaymentId" value="@ViewBag.PaymentId" />
                            <input type="hidden" id="hdnAction" value="Add" />
                            <div class="row" id="appendForm">
                                <div class="nxl-content">
                                    <div class="main-content">
                                        <div class="row mt-2">
                                            <div class="col-12">
                                                <div class="card border-top-0">
                                                    <div class="card-body">
                                                        <h5 class="mb-3 fw-bold">Client & Invoice Selection</h5>
                                                        <div class="row g-3">
                                                            <div class="col-6">
                                                                <label class="form-label">Client <strong style="color:orangered">*</strong></label>
                                                                <select class="form-select" id="ddlClient" name="ddlClient">
                                                                </select>
                                                            </div>
                                                            <div class="col-6">
                                                                <label class="form-label">Invoice No <strong style="color:orangered">*</strong></label>
                                                                <select class="form-select" id="ddlInvoiceNo" name="ddlInvoiceNo">
                                                                </select>
                                                            </div>

                                                            <div class="col-12">
                                                                <div class="table-responsive">
                                                                    <table class="table table-bordered" id="tblInvoiceDetail">
                                                                        <thead>
                                                                            <tr>
                                                                                <th>Item Description</th>
                                                                                <th class="text-end">Quantity</th>
                                                                                <th class="text-end">Unit Price</th>
                                                                                <th class="text-end">Amount</th>
                                                                                <th class="text-end">Tax %</th>
                                                                                <th class="text-end">Tax Amount</th>
                                                                                <th class="text-end">Total Amount</th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody id="inv_dtl"></tbody>
                                                                        <tfoot>
                                                                            <tr>
                                                                                <th colspan="6" class="text-end">Subtotal</th>
                                                                                <td class="text-end" id="lblSubTotal">0.00</td>
                                                                            </tr>
                                                                            <tr>
                                                                                <th colspan="6" class="text-end">Tax Total</th>
                                                                                <td class="text-end" id="lblTaxTotal">0.00</td>
                                                                            </tr>
                                                                            <tr>
                                                                                <th colspan="6" class="text-end">Grand Total</th>
                                                                                <td class="text-end" id="lblGrandTotal">0.00</td>
                                                                            </tr>
                                                                        </tfoot>
                                                                    </table>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <hr class="my-0">

                                                    <div class="card-body">
                                                        <h5 class="mb-3 fw-bold">References</h5>
                                                        <div class="row g-3">
                                                            <div class="col-12 col-md-6">
                                                                <label class="form-label">Amount Received <strong style="color:orangered">*</strong></label>
                                                                <input class="form-control" type="number" id="amount_received">
                                                            </div>
                                                            <div class="col-12 col-md-6">
                                                                <label class="form-label w-100">Payment Mode <strong style="color:orangered">*</strong></label>
                                                                <div class="btn-group bg-light px-3 py-1 gap-2" role="group">
                                                                    <input type="radio" class="btn-check" name="pmode" id="rdoCash" autocomplete="off" checked value="Cash">
                                                                    <label class="btn rounded" for="rdoCash">Cash</label>

                                                                    <input type="radio" class="btn-check" name="pmode" id="rdoChq" autocomplete="off" value="Cheque">
                                                                    <label class="btn rounded" for="rdoChq">Cheque</label>

                                                                    <input type="radio" class="btn-check" name="pmode" id="rdoBankTransfer" autocomplete="off" value="Bank Transfer">
                                                                    <label class="btn rounded" for="rdoBankTransfer">Bank Transfer</label>
                                                                </div>
                                                            </div>
                                                            <div class="row mt-3" id="check">
                                                                <div class="col-12 col-md-6 col-lg-4">
                                                                    <label class="form-label">Checque No</label>
                                                                    <input class="form-control" type="text" id="chq_no">
                                                                </div>
                                                                <div class="col-12 col-md-6 col-lg-4">
                                                                    <label class="form-label">Bank Name</label>
                                                                    <input class="form-control" type="text" id="bank_name">
                                                                </div>
                                                                <div class="col-12 col-md-6 col-lg-4">
                                                                    <label class="form-label">Value Date</label>
                                                                    <input class="form-control" type="date" id="value_date">
                                                                </div>
                                                            </div>
                                                            <div class="row mt-3 d-none" id="bank">
                                                                <div class="col-12 col-md-6 col-lg-4">
                                                                    <label class="form-label">Reference Number</label>
                                                                    <input class="form-control" type="text" id="ref_no">
                                                                </div>
                                                                <div class="col-12 col-md-6 col-lg-4">
                                                                    <label class="form-label">Transfer Date</label>
                                                                    <input class="form-control" type="date" id="transfer_date">
                                                                </div>
                                                            </div>

                                                            <div id="docSection" class="col-12 uploader">
                                                                <label class="form-label">Receipt Upload</label>
                                                                <label class="upload-box w-100">
                                                                    <input type="file" id="receipt_upload" name="receipt_upload" class="d-none file-input" multiple accept=".pdf, .doc, .docx">
                                                                    <h5>Click to Upload</h5>
                                                                    <p class="text-muted mb-0">PDF, DOC, DOCX</p>
                                                                </label>
                                                                <div class="preview-container row"></div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            @if (_allowinsert)
                            {
                                <br />
                                <div class="row ">
                                    @* <div class="d-flex justify-content-end flex-wrap" id="actionId"></div> *@
                                    <div class="d-flex justify-content-end flex-wrap" id="actionId">
                                        <button type="button" class="btn btn-success btn-sm SaveBtn" id="SaveBtn"><i class="feather-save pe-2"></i>Save</button>

                                    </div>
                                </div>
                            }
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section BottomJS {
    <script src="~/Public/js/vendors.min.js"></script>
    <script src="~/Public/js/common-init.min.js"></script>
    @* <script src="~/Public/js/client-onboarding.js"></script> *@

    <script src="~/Public/vendor/leaderline/leaderline.js"></script>
    <script src="~/Public/js/custom-js/Workflow/WorkflowManager.js"></script>
    <script src="~/Public/js/custom-js/Trans/PaymentForm.js"></script>
}