@inject RevenueBillingApp.Models.Session.Sessions Sessions_
@{
    ViewBag.Title = "Reports Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section TopCss
{
    <link href="~/public/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/public/css/vendors.min.css" rel="stylesheet" />
    <link href="~/public/css/theme.min.css" rel="stylesheet" />
    <link href="~/public/css/custom-css/BillingRevenue/ReportDashboard.css" rel="stylesheet" />
}

<div class="main-content">
    <div class="page-header">
        <div class="page-header-left">
            <div class="page-header-title">
                <h4 class="m-b-10">Reports</h4>
            </div>
            <p class="mb-0">Select a report to view or export</p>
        </div>
    </div>

    <div class="row mt-3 g-3">

        <div class="col-md-6 col-lg-3">
            <div class="card report-card" data-bs-toggle="modal" data-bs-target="#clientListModal">
                <div class="card-body text-center">
                    <div class="report-icon bg-color-0">
                        <i class="feather-users"></i>
                    </div>
                    <h6 class="mt-3 mb-1">Client List</h6>
                    <p class="text-muted small mb-0">All onboarded clients</p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card report-card" data-bs-toggle="modal" data-bs-target="#contractListModal">
                <div class="card-body text-center">
                    <div class="report-icon bg-color-2">
                        <i class="feather-file-text"></i>
                    </div>
                    <h6 class="mt-3 mb-1">Client Contract List</h6>
                    <p class="text-muted small mb-0">Contracts per client</p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card report-card" data-bs-toggle="modal" data-bs-target="#invoiceListModal">
                <div class="card-body text-center">
                    <div class="report-icon bg-color-4">
                        <i class="feather-file"></i>
                    </div>
                    <h6 class="mt-3 mb-1">Client Invoice List</h6>
                    <p class="text-muted small mb-0">All invoices per client</p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card report-card" data-bs-toggle="modal" data-bs-target="#invoiceDueModal">
                <div class="card-body text-center">
                    <div class="report-icon bg-color-1">
                        <i class="feather-alert-circle"></i>
                    </div>
                    <h6 class="mt-3 mb-1">Invoice Due Report</h6>
                    <p class="text-muted small mb-0">Overdue/pending invoices</p>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- ========================================= -->
<!-- MODAL 1: Client List -->
<!-- ========================================= -->
<div class="modal fade" id="clientListModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="feather-users me-2"></i>Client List</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Order By:</label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="clOrderBy" id="clOrderName" value="ClientName" checked>
                            <label class="form-check-label" for="clOrderName">Client Name</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="clOrderBy" id="clOrderIndustry" value="IndustryName">
                            <label class="form-check-label" for="clOrderIndustry">Industry Name</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="clOrderBy" id="clOrderCountry" value="CountryName">
                            <label class="form-check-label" for="clOrderCountry">Country Name</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="clOrderBy" id="clOrderDate" value="OnboardingStartDate">
                            <label class="form-check-label" for="clOrderDate">Onboarding Start Date</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Filter — Industry Name:</label>
                        <select class="form-select" id="ddlClientListIndustry">
                            <option value="0">Please select</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-between">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="chkClientListExcel">
                    <label class="form-check-label" for="chkClientListExcel">Export Excel</label>
                </div>
                <button type="button" class="btn btn-success" id="btnViewClientListReport">
                    <i class="feather-bar-chart-2 me-2"></i>View Report
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================= -->
<!-- MODAL 2: Client Contract List -->
<!-- ========================================= -->
<div class="modal fade" id="contractListModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="feather-file-text me-2"></i>Client Contract List</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label class="form-label">Client:</label>
                <select class="form-select" id="ddlContractListClient">
                    <option value="0">Please select</option>
                </select>
            </div>
            <div class="modal-footer justify-content-between">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="chkContractListExcel">
                    <label class="form-check-label" for="chkContractListExcel">Export Excel</label>
                </div>
                <button type="button" class="btn btn-success" id="btnViewContractListReport">
                    <i class="feather-bar-chart-2 me-2"></i>View Report
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================= -->
<!-- MODAL 3: Client Invoice List -->
<!-- ========================================= -->
<div class="modal fade" id="invoiceListModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="feather-file me-2"></i>Client Invoice List</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label class="form-label">Client:</label>
                <select class="form-select" id="ddlInvoiceListClient">
                    <option value="0">Please select</option>
                </select>
            </div>
            <div class="modal-footer justify-content-between">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="chkInvoiceListExcel">
                    <label class="form-check-label" for="chkInvoiceListExcel">Export Excel</label>
                </div>
                <button type="button" class="btn btn-success" id="btnViewInvoiceListReport">
                    <i class="feather-bar-chart-2 me-2"></i>View Report
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================= -->
<!-- MODAL 4: Invoice Due Report -->
<!-- ========================================= -->
<div class="modal fade" id="invoiceDueModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="feather-alert-circle me-2"></i>Invoice Due Report</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label class="form-label">Client:</label>
                <select class="form-select" id="ddlInvoiceDueClient">
                    <option value="0">Please select</option>
                </select>
            </div>
            <div class="modal-footer justify-content-between">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="chkInvoiceDueExcel">
                    <label class="form-check-label" for="chkInvoiceDueExcel">Export Excel</label>
                </div>
                <button type="button" class="btn btn-success" id="btnViewInvoiceDueReport">
                    <i class="feather-bar-chart-2 me-2"></i>View Report
                </button>
            </div>
        </div>
    </div>
</div>


@section BottomJS {
    <script src="~/public/js/custom-js/BillingRevenue/ReportDashboard.js"></script>
}