@inject RevenueBillingApp.Models.Session.Sessions Sessions_
@{
    ViewBag.Title = "ClientOnboarding";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section TopCss
{
    <link href="~/public/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/public/css/vendors.min.css" rel="stylesheet" />
    <link href="~/public/vendor/jquery-steps/jquery.steps.min.css" rel="stylesheet" />
    <link href="~/public/css/theme.min.css" rel="stylesheet" />
    <link href="~/public/css/custom-css/BillingRevenue/ClientOnboarding.css" rel="stylesheet" />
    <link href="~/public/css/custom-css/BillingRevenue/ClientInvoicePrint.css" rel="stylesheet" />
}

@{
    System.Security.Claims.ClaimsPrincipal claimsPrincipal = Context.User;
    var UniqueKey = (from c in claimsPrincipal.Claims where c.Type == "Guid" select c.Value).FirstOrDefault();
    var UserID = (from c in claimsPrincipal.Claims where c.Type == "UserID" select c.Value).FirstOrDefault();
    RevenueBillingApp.Models.Session.SessionItems sessionItems = Sessions_.GetSession(UniqueKey, UserID);
    List<RevenueBillingApp.Models.Authentication.RolesMapping> rolesMapping = sessionItems.rolesMapping;
    var FilterForm = rolesMapping.FirstOrDefault(x => x.FormName == Context.Request.RouteValues["controller"] + "/" + Context.Request.RouteValues["action"]);
    bool _allowinsert = FilterForm.AllowInsert;
    bool _allowupdate = FilterForm.AllowUpdate;
    bool _allowdelete = FilterForm.AllowDelete;
    string wfCode = ViewBag.wfCode;
    string defaultform = sessionItems.userInfo.DefaultFormName;
}

<div class="main-content">
    <div class="page-header">
        <div class="page-header-left">
            <div class="page-header-title">
                <h4 class="m-b-10">Client Onboarding Overview</h4>
            </div>
            <p class="mb-0">Create the client record + define contract basics</p>
        </div>
    </div>
    <div class="row mt-2">
        <div class="col-12">
            <div class="card border-top-0">
                <div class="card-body p-0 wizard clearfix" id="client-onboarding" role="application">

                    <!-- STEP 1: Client Onboarding -->
                    <div class="step-title">Client Onboarding</div>
                    <section class="step-body">
                        <form id="form-client-onboarding" name="form-client-onboarding" method="post" action="">
                            <div class="new-existing-client" id="CustomerRadioBoxBlock">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="new_existing" id="NewClient" checked="checked">
                                            <label class="form-check-label" for="NewClient">New Client</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="new_existing" id="ExistingClient">
                                            <label class="form-check-label" for="ExistingClient">Existing Client</label>
                                        </div>
                                    </div>
                                </div>
                            </div> 

                            <div id="search_client" class="d-none">
                                <h5 class="mb-3 fw-bold">Search Existing Client:</h5>

                                <div class="row g-3">
                                    <div class="col-12 col-md-8 col-lg-6">
                                        <label class="form-label">
                                            Client Name or Mobile Number:
                                            <strong style="color:orangered">*</strong>
                                        </label>

                                        <input class="form-control"
                                               type="text"
                                               id="clientSearchValue"
                                               autocomplete="off"
                                               placeholder="Enter mobile number or client name">
                                    </div>
                                </div>

                                <!-- Accordion Style Search Result -->
                                <div id="existingClientResults" class="mt-3 d-none">

                                    <div class="card">
                                        <div class="card-header d-flex justify-content-between align-items-center"
                                             id="existingClientHeader"
                                             style="cursor:pointer;">

                                            <strong>
                                                Existing Clients
                                                <span id="existingClientCount" class="badge bg-primary ms-2"></span>
                                            </strong>

                                            <i id="existingClientToggleIcon" class="fa fa-chevron-up"></i>
                                        </div>

                                        <div id="existingClientBody" class="card-body p-0" style="display:none;">

                                            <div class="table-responsive">
                                                <table class="table table-hover mb-0" id="existingClientGrid">
                                                    <thead>
                                                        <tr>
                                                            <th>Ref No</th>
                                                            <th>Client Name</th>
                                                            <th>Contact Person</th>
                                                            <th>Mobile</th>
                                                            <th>Email</th>
                                                        </tr>
                                                    </thead>

                                                    <tbody></tbody>
                                                </table>
                                            </div>

                                        </div>

                                    </div>

                                </div>

                                <hr>
                            </div>



                            <div id="clientInfoSection">
                                <input type="hidden" id="hdnClientId" value="0" disabled />
                                <input type="hidden" id="hdnAction" value="Add" disabled />

                                <h5 class="mb-3 fw-bold">Client Information</h5>
                                <div class="row g-3">
                                    <div class="col-12 col-md-6 col-lg-3">
                                        <label class="form-label">Client Ref No:</label>
                                        <input class="form-control" type="text" placeholder="Client-2026-1" id="client_refno" disabled>
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-3" id="new_client">
                                        <label class="form-label">Client Name: <strong style="color:orangered">*</strong></label>
                                        <input class="form-control" type="text" id="client_name" name="client_name" autocomplete="off">
                                    </div>

                                    <div class="col-12 col-md-6 col-lg-3">
                                        <label class="form-label">Industry: <strong style="color:orangered">*</strong></label>
                                        <select class="form-select" id="ddlIndustry" name="industry_id">
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-3">
                                        <label class="form-label">Company Size: <strong style="color:orangered">*</strong></label>
                                        <select class="form-select" id="ddlCompanySize" name="company_size_id">
                                        </select>
                                    </div>
                                </div>

                                <div class="row g-3">
                                    <div class="col-12 col-md-6 col-lg-3">
                                        <label class="form-label">Website:</label>
                                        <input class="form-control" type="url" id="website" name="website" placeholder="https://www.google.com" autocomplete="off">
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-3">
                                        <label class="form-label">Tax Registration No: <strong style="color:orangered">*</strong></label>
                                        <input class="form-control" type="text" id="tax_registration_no" name="tax_registration_no" autocomplete="off">
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-3">
                                        <label class="form-label">Country: </label>
                                        <select class="form-select" id="ddlCountry" name="country_id">
                                        </select>
                                    </div>

                                    <div class="col-3 col-md-3 col-lg-3">
                                        <label class="form-label">Onboarding Start Date: <strong style="color:orangered">*</strong></label>
                                        <input class="form-control" type="date" id="onboarding_start_date" name="onboarding_start_date">
                                    </div>
                                </div>
                                <div class="row g-3">
                                    <div class="col-12 col-md-12 col-lg-12">
                                        <label class="form-label">Billing Address: <strong style="color:orangered">*</strong></label>
                                        <textarea class="form-control" rows="3" id="billing_address" name="billing_address"></textarea>
                                    </div>
                                </div>
                                <hr>

                                <h5 class="fw-bold mb-3">Primary Contact Details</h5>
                                <div class="row g-3">
                                    <div class="col-12 col-md-6 col-lg-4">
                                        <label class="form-label">Full Name: <strong style="color:orangered">*</strong></label>
                                        <input class="form-control" type="text" id="primary_contact_name" name="primary_contact_name" autocomplete="off">
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-4">
                                        <label class="form-label">Email Address: <strong style="color:orangered">*</strong></label>
                                        <input class="form-control" type="email" id="primary_contact_email" name="primary_contact_email" placeholder="test@outlook.com" autocomplete="off">
                                    </div>

                                    <div class="col-12 col-md-6 col-lg-4">
                                        <label class="form-label">Phone Number: <strong style="color:orangered">*</strong></label>
                                        <input class="form-control"
                                               type="text"
                                               id="primary_contact_phone"
                                               name="primary_contact_phone"
                                               maxlength="15"
                                               autocomplete="off"
                                               placeholder="923001234567">

                                    </div>
                                </div>
                                <hr>

                                <h5 class="mb-3 fw-bold">Commercial Setup</h5>
                                <div class="row g-3">
                                    <div class="col-12 col-md-6 col-lg-4">
                                        <label class="form-label">Account Owner (Internal): <strong style="color:orangered">*</strong></label>
                                        <input class="form-control" type="text" id="txtAccOwner" name="txtAccOwner" autocomplete="off">
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-4">
                                        <label class="form-label">Support Owner: <strong style="color:orangered">*</strong></label>
                                        <select class="form-select" id="ddlsupOwner" name="support_owner_id">
                                        </select>
                                    </div>
                                </div>
                                <hr>

                                <h5 class="mb-3 fw-bold">Required Documents: <strong style="color:orangered">*</strong></h5>
                                <input type="hidden" id="hdnNDAFile" name="nda_filename">
                                <input type="hidden" id="hdnTaxFile" name="tax_verify_filename">
                                <div class="row g-3">
                                    <div class="col-md-6 uploader">
                                        <label class="upload-box w-100">
                                            <input type="file"
                                                   id="nda_upload"
                                                   name="nda_upload"
                                                   class="d-none upload-file"
                                                   accept=".pdf,.doc,.docx">

                                            <h5>Upload NDA</h5>
                                            <p class="file-text text-muted mb-0">
                                                PDF, DOCX, DOC
                                            </p>

                                            <small id="nda_existing_file" class="text-primary d-block mt-2"></small>

                                            <div id="nda_actions" class="mt-2" style="display:none;">
                                                <a href="javascript:void(0)" id="previewNDA" class="text-primary me-3">
                                                    <i class="fa-solid fa-eye"></i> Preview
                                                </a>
                                            </div>

                                            <div id="nda_file_info" class="mt-2" style="display:none;">
                                                <small class="text-muted">
                                                    File Size: <strong id="nda_file_size"></strong>
                                                    <span class="mx-1">||</span>
                                                    Max File Size Allowed: <strong>12 MB</strong>
                                                </small>
                                            </div>

                                        </label>
                                    </div>

                                    <div class="col-md-6 uploader">
                                        <label class="upload-box w-100">
                                            <input type="file"
                                                   id="tax_verify_upload"
                                                   name="tax_verify_upload"
                                                   class="d-none upload-file"
                                                   accept=".pdf,.doc,.docx">

                                            <h5>Upload Tax Verification Document</h5>

                                            <p class="file-text text-muted mb-0">
                                                PDF, DOCX, DOC
                                            </p>

                                            <small id="tax_existing_file" class="text-primary d-block mt-2"></small>

                                            <div id="tax_actions" class="mt-2" style="display:none;">
                                                <a href="javascript:void(0)" id="previewtax" class="text-primary me-3">
                                                    <i class="fa-solid fa-eye"></i> Preview
                                                </a>
                                            </div>

                                            <div id="tax_file_info" class="mt-2" style="display:none;">
                                                <small class="text-muted">
                                                    File Size: <strong id="tax_file_size"></strong>
                                                    <span class="mx-1">||</span>
                                                    Max File Size Allowed: <strong>12 MB</strong>
                                                </small>
                                            </div>

                                        </label>
                                    </div>

                                </div>
                                <hr>

                                <h5 class="mb-3 fw-bold">Internal Administration</h5>
                                <div class="mt-3">
                                    <label class="form-label">Priority Level</label>
                                    <div class="row g-2 priority-btn-group" role="group">
                                        <div class="col">
                                            <input type="radio" class="btn-check" name="priority_level" id="prio-low" value="low">
                                            <label class="btn w-100 bg-light d-block text-center rounded-3" for="prio-low">Low</label>
                                        </div>
                                        <div class="col">
                                            <input type="radio" class="btn-check" name="priority_level" id="prio-med" value="medium">
                                            <label class="btn w-100 bg-light d-block text-center rounded-3" for="prio-med">Medium</label>
                                        </div>
                                        <div class="col">
                                            <input type="radio" class="btn-check" name="priority_level" id="prio-high" value="high">
                                            <label class="btn w-100 bg-light d-block text-center rounded-3" for="prio-high">High</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </section>

                    <!-- STEP 2: Contract -->
                    <div class="step-title">Contract</div>
                    <section class="step-body">
                        <form id="form-contract">
                            <input type="hidden" id="hdnContractId" value="0" disabled />
                            <input type="hidden" id="hdnContractEditMode" value="0">

                            <h5 class="mb-3 fw-bold">Contract Basics</h5>
                            <div class="row g-3">
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Contract Ref No:</label>
                                    <input class="form-control" type="text" placeholder="CNT-2026-1" id="contract_no" disabled>
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Client Name</label>
                                    <input class="form-control" type="text" placeholder="BMC" id="con_clientname" disabled>
                                </div>
                                <div class="col-12 col-md-6 col-lg-4">
                                    <label class="form-label">Contract Type: <strong style="color:orangered">*</strong></label>
                                    <select class="form-select" id="ddlbasicContractType" name="basic_contract_type">
                                    </select>
                                </div>
                            </div>
                            <hr>

                            <div id="saas" class="d-none">
                                <h5 class="mb-3 fw-bold">SaaS Specific</h5>
                                <div class="row g-3">
                                    <div class="col-12 col-md-4">
                                        <label class="form-label">Billing Frequency: <strong style="color:orangered">*</strong></label>
                                        <select class="form-select" id="ddlBillingFreq" name="bill_freq_id">
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label">Contract Start Date: <strong style="color:orangered">*</strong></label>
                                        <input class="form-control" type="date" id="bill_start_date" name="bill_start_date">
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label">Contract End Date: <strong style="color:orangered">*</strong></label>
                                        <input class="form-control" type="date" id="bill_end_date" name="bill_end_date">
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">Billing Cycle Day</label>
                                        <select class="form-select" id="ddlBillingCycle" name="billing_cycle">
                                            <option value="0" selected>Select Billing Cycle Day</option>
                                            @for (int i = 1; i <= 31; i++)
                                            {
                                                <option value="@i">@i</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-3">
                                        <label class="form-label">Billing Type</label>
                                        <select class="form-select" id="ddlBillingType">
                                        </select>
                                    </div>
                                </div>

                                <div class="row g-3">
                                    <div class="col-12 col-md-6 col-lg-2">
                                        <label class="form-label">Currency: <strong style="color:orangered">*</strong></label>
                                        <select class="form-select" id="ddlCurrency" name="ddlCurrency">
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-2">
                                        <label class="form-label">Contract Amount: <strong style="color:orangered">*</strong></label>
                                        <input class="form-control" type="number" id="contract_value" name="contract_value" autocomplete="off">
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-2">
                                        <label class="form-label">Discount % (if any)</label>
                                        <input class="form-control" type="number" id="discount" name="discount_percent" autocomplete="off">
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-2">
                                        <label class="form-label">Tax %</label>
                                        <input class="form-control" type="number" id="tax" name="tax_percent" autocomplete="off">
                                    </div>   
                                    
                                    <div class="col-12 col-md-6 col-lg-2">
                                        <label class="form-label">Total Amount:</label>
                                        <input class="form-control" type="text" id="total_saas_amount" name="total_saas_amount" disabled>
                                    </div>

                                </div>
                                <hr>

                            </div>

                            <div id="custom" class="d-none">
                                <h5 class="mb-3 fw-bold">Custom Project Specific</h5>
                                <div class="row g-3">
                                    <div class="col-12 col-md-3 col-lg-3">
                                        <label class="form-label">Billing Type</label>
                                        <select class="form-select" id="ddlBillingType2">
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-6">
                                        <label class="form-label">Project Name: <strong style="color:orangered">*</strong></label>
                                        <input class="form-control" type="text" id="projectname" autocomplete="off">
                                    </div>
                                    <div class="col-12 col-md-3 col-lg-3">
                                        <label class="form-label">Payment Terms: <strong style="color:orangered">*</strong></label>
                                        <select class="form-select" id="ddlPaymentTerms" name="payment_term_id">
                                        </select>
                                    </div>
                                </div>
                                
                                <div class="row g-3">
                                    <div class="col-12 col-md-6 col-lg-2">
                                        <label class="form-label">Total Project Value</label>
                                        <input class="form-control" type="number" id="projectValue" name="projectValue" autocomplete="off">
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-2">
                                        <label class="form-label">Discount % (if any)</label>
                                        <input class="form-control" type="number" id="m_discountper" name="m_discountper" autocomplete="off">
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-2">
                                        <label class="form-label">Tax %</label>
                                        <input class="form-control" type="number" id="m_taxper" name="m_taxper" autocomplete="off">
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-2">
                                        <label class="form-label">Final Amount</label>
                                        <input class="form-control" type="text" id="final_amount" name="final_amount" disabled>
                                    </div>

                                    <div class="col-12 col-md-6 col-lg-2">
                                        <label class="form-label">Number of Milestones</label>
                                        <input class="form-control" type="text" id="noMilestone" name="noMilestone" min="1" max="10" autocomplete="off">
                                    </div>
                                </div>
                                <hr>

                                <div class="row g-3">
                                    <div class="table-responsive mt-3">
                                        <table class="table table-bordered table-hover table-striped milestone-table table-fixed" id="tblMilestone">
                                            <thead>
                                                <tr>
                                                    <th class="col-milestone">Milestone</th>
                                                    <th class="col-amount">Final Amount</th>
                                                    <th class="col-date">Due Date</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                            <tfoot>
                                                <tr class="table-secondary fw-bold">
                                                    <td colspan="1" class="text-end">Grand Total :</td>
                                                    <td>
                                                        <input type="text" id="txtGrandTotal" class="form-control fw-bold" readonly />
                                                    </td>
                                                    <td></td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                </div>
                                <hr>

                            </div>

                            <div id="docSection" class="d-none">
                                <input type="hidden" id="hdndoc1File" name="doc1_filename">
                                <input type="hidden" id="hdndoc2File" name="doc2_filename">
                                <input type="hidden" id="hdndoc3File" name="doc3_filename">
                                <input type="hidden" id="hdndoc4File" name="doc4_filename">

                                <h5 class="mb-3 fw-bold">Contract Document: <strong style="color:orangered">*</strong></h5>
                                <div class="row">
                                    <div class="col-md-6 uploader">
                                        <label class="upload-box w-100">
                                            <input type="file"
                                                   id="doc1_upload"
                                                   name="doc1_upload"
                                                   class="d-none upload-file"
                                                   accept=".pdf,.doc,.docx">

                                            <h5>Upload Signed Contract</h5>
                                            <p class="file-text text-muted mb-0">
                                                PDF, DOCX, DOC
                                            </p>
                                            <small id="doc1_existing_file" class="text-primary d-block mt-2"></small>

                                            <div id="doc1_actions" class="mt-2" style="display:none;">
                                                <a href="javascript:void(0)" id="previewdoc1" class="text-primary me-3">
                                                    <i class="fa-solid fa-eye"></i> Preview
                                                </a>
                                            </div>

                                            <div id="doc1_file_info" class="mt-2" style="display:none;">
                                                <small class="text-muted">
                                                    File Size: <strong id="doc1_file_size"></strong>
                                                    <span class="mx-1">||</span>
                                                    Max File Size Allowed: <strong>12 MB</strong>
                                                </small>
                                            </div>

                                        </label>
                                    </div>

                                    <div class="col-md-6 uploader">
                                        <label class="upload-box w-100">
                                            <input type="file"
                                                   id="doc2_upload"
                                                   name="doc2_upload"
                                                   class="d-none upload-file"
                                                   accept=".pdf,.doc,.docx">

                                            <h5>Upload Approved Proposal</h5>
                                            <p class="file-text text-muted mb-0">
                                                PDF, DOCX, DOC
                                            </p>
                                            <small id="doc2_existing_file" class="text-primary d-block mt-2"></small>

                                            <div id="doc2_actions" class="mt-2" style="display:none;">
                                                <a href="javascript:void(0)" id="previewdoc2" class="text-primary me-3">
                                                    <i class="fa-solid fa-eye"></i> Preview
                                                </a>
                                            </div>

                                            <div id="doc2_file_info" class="mt-2" style="display:none;">
                                                <small class="text-muted">
                                                    File Size: <strong id="doc2_file_size"></strong>
                                                    <span class="mx-1">||</span>
                                                    Max File Size Allowed: <strong>12 MB</strong>
                                                </small>
                                            </div>

                                        </label>
                                    </div>

                                 </div>

                                <h5 class="mb-3 fw-bold">Project Scope Document: </h5>
                                <div class="row">
                                    <div class="col-md-6 uploader">
                                        <label class="upload-box w-100">
                                            <input type="file"
                                                   id="doc3_upload"
                                                   name="doc3_upload"
                                                   class="d-none upload-file"
                                                   accept=".pdf,.doc,.docx">

                                            <h5>Project Scope Document</h5>
                                            <p class="file-text text-muted mb-0">
                                                PDF, DOCX, DOC
                                            </p>
                                            <small id="doc3_existing_file" class="text-primary d-block mt-2"></small>

                                            <div id="doc3_actions" class="mt-2" style="display:none;">
                                                <a href="javascript:void(0)" id="previewdoc3" class="text-primary me-3">
                                                    <i class="fa-solid fa-eye"></i> Preview
                                                </a>
                                            </div>

                                            <div id="doc3_file_info" class="mt-2" style="display:none;">
                                                <small class="text-muted">
                                                    File Size: <strong id="doc3_file_size"></strong>
                                                    <span class="mx-1">||</span>
                                                    Max File Size Allowed: <strong>12 MB</strong>
                                                </small>
