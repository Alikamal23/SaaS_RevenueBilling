                                <div class="row g-3 mt-1">
                                    <div class="col-12 col-md-6 col-lg-3">
                                        <label class="form-label" id="renewContractValueLabel">Contract Value: <strong style="color:orangered">*</strong></label>
                                        <input class="form-control" type="number" id="renew_contract_value">
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-3">
                                        <label class="form-label">Discount %</label>
                                        <input class="form-control" type="number" id="renew_discount_percent" value="0">
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-3">
                                        <label class="form-label">Tax %</label>
                                        <input class="form-control" type="number" id="renew_tax_percent" value="0">
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-3">
                                        <label class="form-label">Final Amount:</label>
                                        <input class="form-control" type="text" id="renew_final_amount" disabled>
                                    </div>
                                </div>

                                <div class="row g-3 mt-1">

                                    <div class="col-12 col-md-6 col-lg-4">
                                        <label class="form-label">Renewal Status</label>
                                        <select class="form-select" id="renew_status">
                                            <option value="Pending">Pending</option>
                                            <option value="Approved">Approved</option>
                                            <option value="Rejected">Rejected</option>
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-4 d-flex align-items-end">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="renew_auto_renew">
                                            <label class="form-check-label" for="renew_auto_renew">Auto Renew</label>
                                        </div>
                                    </div>

                                    <div class="col-12 col-md-6 col-lg-4">
                                        <label class="form-label">Upload Renewal Document</label>
                                        <input type="file" class="form-control" id="renew_doc_upload" accept=".pdf,.doc,.docx">
                                    </div>
                                </div>

                                <div class="row g-3 mt-2">

                                </div>

                                <button type="button" class="btn btn-secondary mt-3" id="btnBackRenewGrid">
                                    <i class="fa fa-arrow-left"></i> Back
                                </button>


                            </div>

                        </form>
                    </section>

                </div>

                <div class="card-footer" id="client-onboarding-footer" role="application">
                    @if (_allowinsert)
                    {
                        <br />
                        <div class="row">
                            <div class="d-flex justify-content-end flex-wrap" id="actionId">
                                <button type="button" class="btn btn-success btn-sm SaveBtn" id="SaveBtn"><i class="feather-save pe-2"></i>Save</button>

                            </div>
                        </div>
                    }
                </div>

            </div>
        </div>
     </div>
</div> 

