<!-- Modal -->
<div class="modal fade" id="ClientDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="feather-user me-2"></i>
                    Client Details
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Client Name</label>
                        <input type="text" id="txtClientName"
                               class="form-control"
                               readonly>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Industry</label>
                        <input type="text" id="txtIndustry"
                               class="form-control"
                               readonly>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Tax Registration No</label>
                        <input type="text" id="txtTaxNo"
                               class="form-control"
                               readonly>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Country</label>
                        <input type="text" id="txtCountry"
                               class="form-control"
                               readonly>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Primary Contact</label>
                        <input type="text" id="txtPrimaryContact"
                               class="form-control"
                               readonly>
                    </div>

                    <div class="col-md-6">
