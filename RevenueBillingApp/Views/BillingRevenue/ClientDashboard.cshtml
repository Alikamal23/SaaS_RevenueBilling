                        <textarea id="txtAddress"
                                  class="form-control"
                                  rows="3"
                                  readonly></textarea>
                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>

            </div>

        </div>
    </div>
</div>


