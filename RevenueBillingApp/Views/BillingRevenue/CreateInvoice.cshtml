@inject RevenueBillingApp.Models.Session.Sessions Sessions_
@{
    ViewBag.Title = "Invoice Form";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section TopCss
{
    <link rel="stylesheet" type="text/css" href="~/Public/css/custom-css/Workflow/HistoryCards.css" />

    <link rel="stylesheet" type="text/css" href="~/Public/css/vendors.min.css" />
    <link rel="stylesheet" type="text/css" href="~/Public/css/theme.min.css" />
    <link rel="stylesheet" type="text/css" href="~/Public/css/style.css" />
}

@{

    System.Security.Claims.ClaimsPrincipal claimsPrincipal = Context.User;
    var UniqueKey = (from c in claimsPrincipal.Claims where c.Type == "Guid" select c.Value).FirstOrDefault();
    var UserID = (from c in claimsPrincipal.Claims where c.Type == "UserID" select c.Value).FirstOrDefault();
    RevenueBillingApp.Models.Session.SessionItems sessionItems = Sessions_.GetSession(UniqueKey, UserID);
    List<RevenueBillingApp.Models.Authentication.RolesMapping> rolesMapping = sessionItems.rolesMapping;
    var FilterForm = rolesMapping.FirstOrDefault(x => x.FormName == Context.Request.RouteValues["controller"] + "/" + Context.Request.RouteValues["action"]);
    bool _allowinsert = FilterForm.AllowInsert;
    bool _allowupdate = FilterForm.AllowUpdate;
    bool _allowdelete = FilterForm.AllowDelete;
    string wfCode = ViewBag.wfCode;
    string defaultform = sessionItems.userInfo.DefaultFormName;
}

<div class="page-header mb-2">
    <div class="page-header-left">
        <div class="page-header-title">
            <h4 class="m-b-10">Create Invoice</h4>
        </div>
        <p class="mb-0">Create Manual Invoice</p>
    </div>
    <div class="page-header-right ms-auto">
        <div class="page-header-right-items">
            <div class="d-flex">
                <a href="/BillingRevenue/ViewInvoice" class="btn btn-indigo btn-sm"><i class="feather-list pe-2"></i>Listing</a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card stretch stretch-full">
            <div class="card-header p-0">
            </div>
            <div class="card-body">
                <div id="workflowDiv">
                    <div class="div-loader">
                        <div class="loader-wrapper d-none">
                            <span class="loader"></span>
                        </div>
                        <input type="hidden" id="defaultform" value="@defaultform" />

                        <form id="intiateform" name="intiateform" method="post" action="">
                            <input type="hidden" value="@wfCode" id="workflow" name="workflow" />

                            <input type="hidden" id="hdnInvoiceId" value="@ViewBag.InvoiceId" />
                            <input type="hidden" id="hdnAction" value="Add" />
                            <div class="row" id="appendForm">
                                <div class="nxl-content">
                                    <div class="main-content">
                                        <div class="row mt-2">
                                            <div class="col-12">
                                                <div class="card border-top-0">
                                                    <div class="card-body">
                                                        <h5 class="mb-3 fw-bold">Invoice Details</h5>
                                                        <div class="row g-3">
                                                            <div class="col-12 col-md-6 col-lg-4">
                                                                <label class="form-label">Invoice No <strong style="color:orangered">*</strong></label>
                                                                <input class="form-control" type="text" id="invoice_no">
                                                            </div>
                                                            <div class="col-12 col-md-6 col-lg-4">
                                                                <label class="form-label">Client <strong style="color:orangered">*</strong></label>
                                                                <select class="form-select" id="ddlClient" name="ddlClient">
                                                                </select>
                                                            </div>
                                                            <div class="col-12 col-md-6 col-lg-4">
                                                                <label class="form-label">Invoice Date <strong style="color:orangered">*</strong></label>
                                                                <input class="form-control" type="date" id="invoice_date">
                                                            </div>
                                                            <div class="col-12 col-md-6 col-lg-4">
                                                                <label class="form-label">Due Date</label>
                                                                <input class="form-control" type="date" id="due_date">
                                                            </div>
                                                            <div class="col-12 col-md-6 col-lg-4 mt-lg-auto">
                                                                <label class="form-label">Billing Type <strong style="color:orangered">*</strong></label>
                                                                <select class="form-select" id="ddlBillingType" name="ddlBillingType">
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <hr class="my-0">

                                                    <div class="card-body">
                                                        <h5 class="mb-3 fw-bold">Line Items</h5>

                                                        <button type="button" id="btnAddRow" class="btn btn-primary btn-sm mb-2">
                                                            + Add Item
                                                        </button>

                                                        <div class="row g-3">
                                                            <div class="col-12">
                                                                <div class="table-responsive">
                                                                    <table class="table table-bordered invoice-grid">
                                                                        <thead>
                                                                            <tr>
                                                                                <th style="width:30%">Item Description</th>
                                                                                <th style="width:8%" class="text-center">Qty</th>
                                                                                <th style="width:12%" class="text-end">Unit Price</th>
                                                                                <th style="width:12%" class="text-end">Amount</th>
                                                                                <th style="width:8%" class="text-end">Tax %</th>
                                                                                <th style="width:12%" class="text-end">Tax Amount</th>
                                                                                <th style="width:12%" class="text-end">Total Amount</th>
                                                                                <th style="width:6%" class="text-center">Action</th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody id="tbltbody">
                                                                            <tr>
                                                                                <td>
                                                                                    <input type="text" class="form-control item_desc" placeholder="Item description">
                                                                                </td>

                                                                                <td>
                                                                                    <input type="number" class="form-control form-control-sm qty text-end" value="1">
                                                                                </td>

                                                                                <td>
                                                                                    <input type="number" class="form-control form-control-sm unit_price text-end" value="0">
                                                                                </td>

                                                                                <td class="amount text-end align-middle">0.00</td>

                                                                                <td>
                                                                                    <input type="number" class="form-control form-control-sm tax_percent text-end" value="0">
                                                                                </td>

                                                                                <td class="tax_amount text-end align-middle">0.00</td>

                                                                                <td class="total_amount text-end align-middle fw-semibold">0.00</td>


                                                                                <td class="text-center">
                                                                                    <button type="button" class="btn btn-danger btn-sm btnRemoveRow">
                                                                                        <i class="feather-trash-2"></i>
                                                                                    </button>
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                        <tfoot>
                                                                            <tr>
                                                                                <th colspan="6" class="text-end">Subtotal</th>
                                                                                <td class="text-end" id="lblSubTotal">0.00</td>
                                                                            </tr>
                                                                            <tr>
                                                                                <th colspan="6" class="text-end">Tax Total</th>
                                                                                <td class="text-end" id="lblTaxTotal">0.00</td>
                                                                            </tr>
                                                                            <tr>
                                                                                <th colspan="6" class="text-end">Grand Total</th>
                                                                                <td class="text-end" id="lblGrandTotal">0.00</td>
                                                                            </tr>
                                                                        </tfoot>
                                                                    </table>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <hr class="my-0">

                                                    <div class="card-body">
                                                        <h5 class="mb-3 fw-bold">References</h5>
                                                        <div class="row g-3">
                                                            <div class="col-12 col-md-6 col-lg-4">
                                                                <label class="form-label">Recurring Billing (if SaaS)</label>
                                                                <select class="form-select" id="ddlRecurringBilling" name="ddlRecurringBilling">
                                                                </select>
                                                            </div>
                                                            <div class="col-12 col-md-6 col-lg-4">
                                                                <label class="form-label">Milestone (if custom)</label>
                                                                <select class="form-select" id="ddlMilestone" name="ddlMilestone">
                                                                </select>
                                                            </div>
                                                            <div class="col-12 col-md-6 col-lg-4">
                                                                <label class="form-label">Contract <strong style="color:orangered">*</strong></label>
                                                                <select class="form-select" id="ddlContract" name="ddlContract">
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <hr class="my-0">

                                                    <div class="card-body" id="docSection">
                                                        <h5 class="mb-3 fw-bold">Attachments</h5>
                                                        <div class="row g-3">
                                                            <div class="col-12 col-md-6 uploader">
                                                                <label class="upload-box w-100">
                                                                    <input type="file" class="d-none file-input" name="inv_pdf" id="inv_pdf" multiple accept=".pdf, .doc, .docx">
                                                                    <h5>Invoice PDF</h5>
                                                                    <p class="text-muted mb-0">PDF</p>
                                                                </label>
                                                                <div class="preview-container row"></div>
                                                            </div>
                                                            <div class="col-12 col-md-6 uploader">
                                                                <label class="upload-box w-100">
                                                                    <input type="file" class="d-none file-input" name="support_pdf" id="support_pdf" multiple accept=".pdf, .doc, .docx">
                                                                    <h5>Supporting Documents</h5>
                                                                    <p class="text-muted mb-0">PDF, DOCX, DOC</p>
                                                                </label>
                                                                <div class="preview-container row"></div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <hr class="my-0">

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            @if (_allowinsert)
                            {
                                <br />
                                <div class="row ">
                                    @* <div class="d-flex justify-content-end flex-wrap" id="actionId"></div> *@
                                    <div class="d-flex justify-content-end flex-wrap" id="actionId">
                                        <button type="button" class="btn btn-success btn-sm SaveBtn" id="SaveBtn"><i class="feather-save pe-2"></i>Save</button>

                                    </div>
                                </div>
                            }
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section BottomJS {
    <script src="~/Public/js/vendors.min.js"></script>
    <script src="~/Public/js/common-init.min.js"></script>

    <script src="~/Public/vendor/leaderline/leaderline.js"></script>
    <script src="~/Public/js/custom-js/Workflow/WorkflowManager.js"></script>
    <script src="~/Public/js/custom-js/BillingRevenue/CreateInvoice.js"></script>
}
