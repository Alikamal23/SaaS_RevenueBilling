@inject RevenueBillingApp.Models.Session.Sessions Sessions_
@{
    ViewBag.Title = "Client Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section TopCss
{
    <link href="~/public/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/public/css/custom-css/BillingRevenue/rpt_ClientInformation.css" rel="stylesheet" />
}

@{
    System.Security.Claims.ClaimsPrincipal claimsPrincipal = Context.User;
    var UniqueKey = (from c in claimsPrincipal.Claims where c.Type == "Guid" select c.Value).FirstOrDefault();
    var UserID = (from c in claimsPrincipal.Claims where c.Type == "UserID" select c.Value).FirstOrDefault();
    RevenueBillingApp.Models.Session.SessionItems sessionItems = Sessions_.GetSession(UniqueKey, UserID);
    List<RevenueBillingApp.Models.Authentication.RolesMapping> rolesMapping = sessionItems.rolesMapping;
    var FilterForm = rolesMapping.FirstOrDefault(x => x.FormName == Context.Request.RouteValues["controller"] + "/" + Context.Request.RouteValues["action"]);
    bool _allowinsert = FilterForm.AllowInsert;
    bool _allowupdate = FilterForm.AllowUpdate;
    bool _allowdelete = FilterForm.AllowDelete;
    string wfCode = ViewBag.wfCode;
    string defaultform = sessionItems.userInfo.DefaultFormName;
}

<div class="container-fluid mt-3 mb-4">
    <div class="row no-print mb-3">
        <div class="col-12 d-flex justify-content-end gap-2">

            <button type="button" class="btn btn-primary" id="btnPrint">
                <i class="feather-printer"></i> Print
            </button>

            <button type="button" class="btn btn-danger" id="btnPDF">
                <i class="feather-file-text"></i> PDF
            </button>

        </div>
    </div>

    <!-- Header -->
    <div class="report-header">

        <div class="row">
            <div class="col-md-2">
                <img src="~/Public/image/report_logo.png" class="logo" />
            </div>

            <div class="col-md-8 text-center">
                <h2>Revenue Billing System</h2>
                <h4>Client Information Report</h4>
            </div>

            <div class="col-md-2 text-end">
                <b>Print Date</b>
                <br />
                <span id="PrintDate"></span>
            </div>
        </div>
    </div>

    <hr />

    <!-- Client Information -->

    <div class="card report-card">
        <div class="card-header">
            Client Information
        </div>

        <div class="card-body">
            <table class="table table-bordered">
                <tr>

                    <th width="20%">Client Name</th>
                    <td id="ClientName"></td>

                    <th width="20%">Client Ref#</th>
                    <td id="ClientRefNo"></td>

                </tr>

                <tr>

                    <th>Industry</th>
                    <td id="Industry"></td>

                    <th>Company Size</th>
                    <td id="CompanySize"></td>

                </tr>

                <tr>

                    <th>Website</th>
                    <td id="Website"></td>

                    <th>Country</th>
                    <td id="Country"></td>

                </tr>

                <tr>

                    <th>Billing Address</th>
                    <td colspan="3" id="BillingAddress"></td>

                </tr>

                <tr>

                    <th>Primary Contact</th>
                    <td id="PrimaryContact"></td>

                    <th>Phone</th>
                    <td id="PrimaryPhone"></td>

                </tr>

                <tr>

                    <th>Email</th>
                    <td id="PrimaryEmail"></td>

                    <th>Tax Registration</th>
                    <td id="TaxRegistration"></td>

                </tr>

                <tr>

                    <th>Priority</th>
                    <td id="Priority"></td>

                    <th>High Value Client</th>
                    <td id="HighValue"></td>

                </tr>

            </table>

        </div>

    </div>

    <div id="ContractContainer">
        <!-- Dynamic Contract Cards -->
    </div>

</div>

@section BottomJS {
    <script src="~/Public/vendor/html2pdf/html2pdf.bundle.min.js"></script>
    <script src="~/public/js/jquery.min.js"></script>
    <script src="~/public/js/custom-js/BillingRevenue/rpt_ClientInformation.js"></script>
}
