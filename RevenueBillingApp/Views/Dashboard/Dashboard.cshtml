@inject RevenueBillingApp.Models.Session.Sessions Sessions_
@{
    ViewBag.Title = "ERP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section TopCss
{
    <link href="~/Public/css/custom-css/Dashboard/dashboard.css" rel="stylesheet" />
}

<div class="container-fluid">

    <!-- Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-1">
                Dashboard
            </h3>

            <small class="text-muted">
                Welcome Back, 
            </small>

        </div>

        <button class="btn btn-success">
            <i class="feather-plus"></i>
            New Transaction
        </button>

    </div>


    <!-- KPI Cards -->

    <div class="row">

        <div class="col-xl-3 col-md-6 mb-4">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small>Total Sales</small>

                            <h2 class="fw-bold mt-2">
                                Rs. 1.25M
                            </h2>

                        </div>

                        <div class="dashboard-icon bg-success">
                            <i class="feather-dollar-sign"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-xl-3 col-md-6 mb-4">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small>Purchase</small>

                            <h2 class="fw-bold mt-2">
                                Rs. 720K
                            </h2>

                        </div>

                        <div class="dashboard-icon bg-primary">
                            <i class="feather-shopping-cart"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-xl-3 col-md-6 mb-4">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small>Receivables</small>

                            <h2 class="fw-bold mt-2">
                                Rs. 315K
                            </h2>

                        </div>

                        <div class="dashboard-icon bg-warning">
                            <i class="feather-credit-card"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-xl-3 col-md-6 mb-4">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small>Pending Orders</small>

                            <h2 class="fw-bold mt-2">
                                42
                            </h2>

                        </div>

                        <div class="dashboard-icon bg-danger">
                            <i class="feather-package"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Charts -->

    <div class="row">

        <div class="col-lg-8">

            <div class="card">

                <div class="card-header">
                    Monthly Sales
                </div>

                <div class="card-body">

                    <div id="salesChart"></div>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card">

                <div class="card-header">
                    Sales Ratio
                </div>

                <div class="card-body">

                    <div id="pieChart"></div>

                </div>

            </div>

        </div>

    </div>


    <!-- Quick Menu -->

    <div class="row mt-4">

        <div class="col-lg-3">

            <div class="card quick-card">

                <div class="card-body text-center">

                    <i class="feather-shopping-cart display-5 text-success"></i>

                    <h6 class="mt-3">
                        Sale Invoice
                    </h6>

                </div>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="card quick-card">

                <div class="card-body text-center">

                    <i class="feather-truck display-5 text-primary"></i>

                    <h6 class="mt-3">
                        Purchase
                    </h6>

                </div>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="card quick-card">

                <div class="card-body text-center">

                    <i class="feather-users display-5 text-warning"></i>

                    <h6 class="mt-3">
                        Customers
                    </h6>

                </div>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="card quick-card">

                <div class="card-body text-center">

                    <i class="feather-file-text display-5 text-danger"></i>

                    <h6 class="mt-3">
                        Reports
                    </h6>

                </div>

            </div>

        </div>

    </div>


    <!-- Tables -->

    <div class="row mt-4">

        <div class="col-lg-8">

            <div class="card">

                <div class="card-header">

                    Recent Transactions

                </div>

                <div class="table-responsive">

                    <table class="table table-hover">

                        <thead>

                            <tr>

                                <th>Invoice</th>

                                <th>Customer</th>

                                <th>Amount</th>

                                <th>Status</th>

                            </tr>

                        </thead>

                    </table>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card">

                <div class="card-header">

                    Notifications

                </div>

                <div class="card-body">

                    <div class="alert alert-warning">
                        5 Pending Approvals
                    </div>

                    <div class="alert alert-success">
                        Backup Completed
                    </div>

                    <div class="alert alert-danger">
                        License expires in 7 days
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section BottomJS {
    <script src="~/Public/vendor/apexcharts/apexcharts.min.js"></script>
    <script src="~/Public/vendor/circle-progress/circle-progress.min.js"></script>
    <script src="~/Public/js/custom-js/Dashboard/Dashboard.js"></script>
}