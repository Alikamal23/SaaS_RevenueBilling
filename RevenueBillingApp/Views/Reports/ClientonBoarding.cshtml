                            <div class="col-lg-4">
                                <label for="fullnameInput" class="fw-semibold">Company Name: <strong style="color:orangered">*</strong></label>
                            </div>
                            <div class="col-lg-8">
                                <div class="input-group">
                                    <div class="input-group-text"><i><input type="checkbox" id="chkCompany" name="chkCompany" value="0"></i></div>
                                    <select class="form-control" name="ddlCompany" id="ddlCompany" multiple="multiple">
                                    </select>
                                </div>
                            </div>
                        </div> *@
                    </div>
                    <div class="col-sm-6 col-md-6 mt-2">
                    </div>
