@inject RevenueBillingApp.Models.Session.Sessions Sessions_
@{
    ViewBag.Title = "KPI Survey Form";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section TopCss {
    @* <link href="~/Public/css/custom-css/Settings/UserMaster.css" rel="stylesheet" /> *@
}

@{
    System.Security.Claims.ClaimsPrincipal claimsPrincipal = Context.User;
    var UniqueKey = (from c in claimsPrincipal.Claims where c.Type == "Guid" select c.Value).FirstOrDefault();
    var UserID = (from c in claimsPrincipal.Claims where c.Type == "UserID" select c.Value).FirstOrDefault();

    RevenueBillingApp.Models.Session.SessionItems sessionItems = Sessions_.GetSession(UniqueKey, UserID);

    List<RevenueBillingApp.Models.Authentication.RolesMapping> rolesMapping = sessionItems.rolesMapping;

    var FilterForm = rolesMapping.FirstOrDefault(x => x.FormName == Context.Request.RouteValues["controller"] + "/" + Context.Request.RouteValues["action"]);
    bool _allowinsert = FilterForm.AllowInsert;
    bool _allowupdate = FilterForm.AllowUpdate;
    bool _allowdelete = FilterForm.AllowDelete;
}

<div class="row">
    <div class="col-12">
        <div class="card stretch stretch-full">
            <div class="card-header">
                <h5 class="card-title">KPI Survey Form</h5>
                @* <button class="btn btn-primary" id="AddBtn" type="button"><i class='feather-user me-2'></i>Key Factors</button> *@
            </div>
            <div class="card-body">
                <form id="masterform" name="masterform" method="post" action="" autocomplete="off">
                    <div class="row" id="Form1">
                        <div class="d-none col-12 col-sm-12 col-md-12 col-lg-3">
                            <input type="text" class="form-control" id="EditID" name="EditID" value="">
                        </div>
                        <div class="col-12 col-sm-12 col-md-12 col-lg-3">
                            <label>Key Factors</label>
                            <select class="form-select" name="keyFactor" id="keyFactor" required>
                                <option value="0">Select Key Factor</option>
                            </select>
                        </div>
                        <div class="col-12 col-sm-12 col-md-12 col-lg-6">
                            <label>Question</label>
                            <textarea class="form-control" id="txtquestion" placeholder="Question" name="txtquestion"></textarea>
                        </div>
                        <div class="col-12 col-sm-12 col-md-3 col-lg-3 mt-3 mt-lg-auto">
                            <input type="checkbox" id="IsActive" name="IsActive">
                            <label>Active</label>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-12 d-flex justify-content-end">
                            @if (_allowinsert)
                            {
                                <button class="btn btn-primary btn-sm savebutton" id="SaveBtn" type="button"><i class='feather-save me-2'></i>Save</button>

                            }
                            @if (_allowupdate)
                            {
                                <button class="btn btn-primary btn-sm d-none  updatebutton" id="UpdateBtn" type="button"><i class='feather-save me-2'></i>Update</button>

                            }
                            <button class="btn btn-danger btn-sm ms-2 clearbutton" id="ClearBtn" type="button"><i class='feather-x me-2'></i>Clear</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-12">
        <div class="card">
            <div class="card-body p-0">
                <div id="UserMasterDiv">
                    <div class="div-loader">
                        <div class="loader-wrapper d-none">
                            <span class="loader"></span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover" id="user-master">
                                <thead>
                                    <tr>
                                        <th>Question</th>
                                        <th>Key Factor Name</th>
                                        <th>Is Active</th>
                                        @if (_allowupdate)
                                        {
                                            <th>Edit</th>
                                        }
                                        @if (_allowdelete)
                                        {
                                            <th>Delete</th>
                                        }

                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade  bd-example-modal-lg" id="ModalActiveDirectoryUsers" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Active Directory Users</h5>
                <button type="button" class="btn-gray close closebtn" data-dismiss="modal" aria-label="Close" id="CloseModalBtn">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row mt-3">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-body">
                                <div id="ADUserMasterDiv">
                                    <div class="div-loader">
                                        <div class="loader-wrapper d-none">
                                            <span class="loader"></span>
                                        </div>
                                        <div class="table-responsive">
                                            <table class="table table-striped table-bordered" id="TblActiveDirectoryUsers">
                                                <thead>
                                                    <tr>
                                                        <th>Key Factor Name</th>
                                                        <th>Status</th>
                                                        <th>Select</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section BottomJS {
    <script src="~/Public/js/custom-js/DMS/KPISurveyForm.js"></script>
}

