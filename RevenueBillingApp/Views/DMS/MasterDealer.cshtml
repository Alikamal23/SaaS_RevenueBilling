@inject RevenueBillingApp.Models.Session.Sessions Sessions_
@{
    ViewBag.Title = "Master Dealer Form";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section TopCss {
    @* <link href="~/Public/css/custom-css/Settings/UserMaster.css" rel="stylesheet" /> *@
}

@{
    System.Security.Claims.ClaimsPrincipal claimsPrincipal = Context.User;
    var UniqueKey = (from c in claimsPrincipal.Claims where c.Type == "Guid" select c.Value).FirstOrDefault();
    var UserID = (from c in claimsPrincipal.Claims where c.Type == "UserID" select c.Value).FirstOrDefault();

    RevenueBillingApp.Models.Session.SessionItems sessionItems = Sessions_.GetSession(UniqueKey, UserID);

    List<RevenueBillingApp.Models.Authentication.RolesMapping> rolesMapping = sessionItems.rolesMapping;

    var FilterForm = rolesMapping.FirstOrDefault(x => x.FormName == Context.Request.RouteValues["controller"] + "/" + Context.Request.RouteValues["action"]);
    bool _allowinsert = FilterForm.AllowInsert;
    bool _allowupdate = FilterForm.AllowUpdate;
    bool _allowdelete = FilterForm.AllowDelete;
}

<div class="row">
    <div class="col-12">
        <div class="card stretch stretch-full">
            <div class="card-header">
                <h5 class="card-title">Master Dealer Form</h5>
                @* <button class="btn btn-primary" id="AddBtn" type="button"><i class='feather-user me-2'></i>Key Factors</button> *@
            </div>
            <div class="card-body">
                <form action="#" id="dealerform">
                    <div class="row">
                        <div class="col-lg-3">
                            <label for="ddl_dealertype" class="form-label">Dealer type :</label>
                            <select class="form-control Category" id="ddl_dealertype" placeholder="Dealer type" name="ddl_dealertype">
                                <option value="0">Select Dealer Type</option>
                            </select>
                        </div>

                        <div class="col-lg-1 d-flex align-items-center">
                            <div class="form-check form-check-inline mt-5">
                                <input type="checkbox" class="form-check-input checkbox-check" id="chk_dealertype">
                                <label class="form-check-label" for="chk_dealertype">All</label>
                            </div>
                        </div>


                        <div class="col-lg-3">
                            <label for="ddl_dealers" class="form-label">Dealer :</label>
                            <select class="form-control Category" id="ddl_dealers" placeholder="Dealer" name="ddl_dealers">
                                <option value="0">Select Dealer</option>
                            </select>
                        </div>

                        <div class="col-lg-1"></div>

                        <div class="col-lg-3">
                            <label for="ddl_dealers" class="form-label">Month :</label>
                            <input type="month" class="form-control" id="datepicker">
                        </div>

                        <div class="col-lg-3 mt-4">
                            <label for="ddl_zone" class="form-label">Zone :</label>
                            <select class="form-control Category" id="ddl_zone" placeholder="Zone" name="ddl_zone"></select>
                        </div>
                        <div class="col-lg-1 d-flex align-items-center">

                            <div class="form-check form-check-inline mt-5">
                                <input type="checkbox" class="form-check-input checkbox-check" checkbox="status" id="chk_zone">
                                <label class="form-check-label" for="chk_zone">All</label>
                            </div>
                        </div>

                        <div class="col-lg-3 mt-4">
                            <label for="ddl_username" class="form-label">Username :</label>
                            <select class="form-control" id="ddl_username" placeholder="Username" name="ddl_username" multiple="multiple">
                                <option value="0">Select Username</option>
                            </select>
                        </div>
                        <div class="col-lg-1 d-flex align-items-center">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 text-right mt-3">
                            <button type="button" id="btn_save" class="btn first-btn"><i class="bx bxs-save pr-2"></i>Assign</button>
                            <button type="button" id="btn_update" class="btn third-btn"><i class="bx bxs-save pr-2"></i>Update</button>
                            <button type="button" id="btn_cancel" class="btn second-btn"><i class="bx bx-x pr-2"></i>Cancel</button>
                        </div>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>


<div class="row mt-4" id="div_dealerinfo">
    <div class="container mt-3">
        <div class="row justify-content-center">
            <div class="col-6 center">
                <div class="card">
                    <div class="card-header text-center">
                        <h3>Dealer Information</h3>
                    </div>
                    <div class="card-body ">

                        <div class="row">

                            <div class="col-lg-6 text-center">
                                <label for="lbl_cnic" class="form-label"><b>Dealer CNIC :</b></label>
                                <label id="lbl_cnic" class="form-label"></label>

                            </div>

                            <div class="col-lg-6  text-center">
                                <label for="lbl_address" class="form-label"><b>Dealer Address :</b></label>
                                <label id="lbl_address" class="form-label"></label>

                            </div>

                            <div class="col-lg-6  text-center">
                                <label for="lbl_contact" class="form-label"><b>Dealer Contact-No :</b></label>
                                <label id="lbl_contact" class="form-label"></label>

                            </div>

                            <div class="col-lg-6  text-center">
                                <label for="lbl_city" class="form-label"><b>Dealer City :</b></label>
                                <label id="lbl_city" class="form-label"></label>

                            </div>


                            <div class="col-lg-12  text-center">
                                <label for="lbl_city" class="form-label"><b>Dealer Image :</b></label>
                                <button id="btn_view" class="btn first-btn"><i class="bx bx-show"></i>View Dealer Image</button>

                            </div>

                        </div>
                    </div>
                </div>


            </div>
        </div>

    </div>

</div>


@section BottomJS {
    <script src="~/Public/js/custom-js/DMS/MasterDealer.js"></script>
}

